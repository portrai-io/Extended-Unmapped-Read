   "source": [
    "## Chlamydia Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "19c54c1d-8883-40f4-aee0-f3ca6a70818a",
   "metadata": {},
   "outputs": [],
   "source": [
    "tissue_dir = os.path.join(BASE_DIR, \"outs\")\n",
    "adata = QC(tissue_dir)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b3850e3d-1f1b-485c-9861-548169eea1ee",
   "metadata": {},
   "outputs": [],
   "source": [
    "summary_path = os.path.join(BASE_DIR, \"barcode_summary_Chlamydia.csv\")\n",
    "\n",
    "if os.path.exists(summary_path):\n",
    "    df = pd.read_csv(summary_path, index_col=0)\n",
    "    adata.obs['all_RNA_reads'] = df['l2']\n",
    "    adata.obs['mean_num_of_mismatches'] = df['l3']\n",
    "    \n",
    "    adata.obs['mismatch_ratio'] = adata.obs['mean_num_of_mismatches'] / (adata.obs['all_RNA_reads'] + 1e-8)\n",
    "    \n",
    "    adata.obs['mismatch_ratio'].replace([np.inf, -np.inf], np.nan, inplace=True)\n",
    "    adata.obs['mismatch_ratio'].fillna(-1, inplace=True)\n",
    "    \n",
    "    cmap = plt.cm.magma\n",
    "    cmap.set_under('gray')\n",
    "    \n",
    "    sc.pl.spatial(adata, color='mismatch_ratio', cmap=cmap, vmax=10, vmin=0)\n",
    "else:\n",
    "    print(f\"Error: {summary_path} 파일을 찾을 수 없습니다.\")"
   ]
  },
